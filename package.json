{
  "name": "ghost-mode",
  "version": "1.0.0",
  "description": "Free iOS GPS location spoofer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ghostmode.app",
    "productName": "Ghost Mode",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/pymobiledevice3.exe",
          "to": "pymobiledevice3.exe"
        },
        {
          "from": "resources/ghost_spoofer.exe",
          "to": "ghost_spoofer.exe"
        }
      ],
      "artifactName": "Ghost-Mode-Windows-${arch}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "device.js",
      "store.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "node_modules/leaflet/**",
      "assets/**"
    ],
    "nsis": {
      "artifactName": "Ghost-Mode-Windows-Setup-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "Ghost-Mode-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build-tools/entitlements.mac.plist",
      "entitlementsInherit": "build-tools/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "resources/pymobiledevice3",
          "to": "pymobiledevice3"
        },
        {
          "from": "resources/ghost_spoofer",
          "to": "ghost_spoofer"
        }
      ]
    },
    "directories": {
      "output": "release"
    },
    "beforePack": "build-tools/verify-helpers.cjs"
  }
}
